pipeline {
    agent any

    stages {
        stage('Check Jenkins Environment') {
            steps {
                sh '''
                    echo "=== JAVA ==="
                    java -version

                    echo "=== MAVEN ==="
                    mvn -version

                    echo "=== REQUIRED TOOLS ==="

                    for tool in ansible terraform aws docker ssh; do
                        if command -v $tool >/dev/null 2>&1; then
                            echo "$tool: INSTALLED"
                        else
                            echo "$tool: NOT INSTALLED"
                        fi
                    done
                '''
            }
        }
    }
}